{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "ngx-connection-service": [
        "dist/ngx-connection-service"
      ],
      "ngx-connection-service/*": [
        "dist/ngx-connection-service/*"
      ]
    }
  }
}
